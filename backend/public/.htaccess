RewriteEngine On
RewriteBase /backend/public/

# 🔥 ВАЖНО: Передаем Authorization в PHP
CGIPassAuth On

# CORS заголовки (ДО RewriteRule)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
    Header set Access-Control-Max-Age "3600"
</IfModule>

# OPTIONS запросы - обрабатываем ДО основных правил
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Если запрос к существующему файлу или папке - отдаем напрямую
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Все API запросы направляем на index.php
RewriteRule ^(.*)$ index.php [QSA,L]